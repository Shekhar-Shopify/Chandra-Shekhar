<style>
.custom-product-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}
.product-item a {
    display: block;
    position: relative;
    padding-top: 100%;
}
.product-item a img {
    position: absolute;
    inset: 0;
}
.product-item {
    position: relative;
}

.product-item .hotspot_icon {
    position: absolute;
}
#shopify-section-{{ section.id }} {
    padding-top: {{  section.settings.padding_top }}px;
    padding-bottom: {{  section.settings.padding_bottom }}px;
}
</style>
<div class="page-width">
    <section-header>
        {%  if section.settings.heading != blank %}
            <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% endif %}
    </section-header>
    <div class="custom-product-list">
    {% for block in section.blocks %}
        <style>
            .hotspot_icon.{{ block.id }}{
                top: {{ block.settings.hotspot_position_top }}px;
                left: {{ block.settings.hotspot_position_left }}px;
            }
    </style>
        <div class="product-item">
        <a href="{{ block.settings.product.url }}">
            <img src="{{ block.settings.product.featured_image | image_url: width: 800 }}" alt="{{ block.settings.product.title }}" height="100%" width="100%">
        </a>
        <span class="hotspot_icon {{ block.id }} quick_view_btn" data-product-handle="{{ block.settings.product.handle }}"> {% render 'icons-plus' %} </span>
        </div> 
    {% endfor %}
    </div>
</div>
<script src="{{ 'custom.js' | asset_url }}" defer="defer"></script>
{% schema %}
  {
    "name": "Custom Product List",
    "class":"custom-product-list-outer",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding Top (px)",
            "min": 0,
            "max": 200,
            "step": 4,
            "default": 40,
            "unit": "px", 
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding Bottom (px)",
            "min": 0,
            "max": 200,
            "step": 4,
            "default": 40,
            "unit": "px", 
        }
    ],
    "blocks": [
        {
            "name": "Produc Grid",
            "type": "product_grid",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Select Product"
                },
                {
                    "type": "range",
                    "id": "hotspot_position_top",
                    "label": "Hotspot Position Top (%)",
                    "min": 0,
                    "max": 200,
                    "step": 8,
                    "default": 40,
                    "unit": "px", 
                },
                {
                    "type": "range",
                    "id": "hotspot_position_left",
                    "label": "Hotspot Position Left (%)",
                    "min": 0,
                    "max": 200,
                    "step": 8,
                    "default": 40,
                    "unit": "px", 
                }
            ]
        }
    ],
    "presets": [
        {
           "name":"Custom Product List",   
        }
    ]
  }
{% endschema %}