    <style>
        .banner-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .banner-header .banner-image {
            height: auto;
            max-width: 154px;
            display: flex;
        }
        .image-outer.section-{{ section.id }} {
            background: {{ section.settings.background_color }};
        }
        .section-{{ section.id }} .banner-sub-header {
            font-weight: 400;
            font-size: 16px;
            line-height: 13.42px;
            letter-spacing: 0px;
            text-align: center;
            margin: 0;
        }
        .section-{{ section.id }} .banner-link.yellow-btn {
            background: #FFF544;
            color: #000;
            text-decoration: none;
            padding: 11.33px 41px;
            margin-block: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
            font-weight: 400;
            font-size: 16px;
            line-height: 20.48px;
            letter-spacing: 0px;
            position: relative;
            transition: all 0.3s ease-in-out;
            z-index: 2
        }
        .section-{{ section.id }} .banner-link.yellow-btn::before {
            background: #000;
            content: "";
            height: 100%;
            left: 0;
            position: absolute;
            top: 0;
            width: 0;
            z-index: -1;
        }
        .section-{{ section.id }} .banner-link.yellow-btn:hover::before {
            width: 100%;
            transition: all 0.3s ease-in-out;
        }
        .section-{{ section.id }} .banner-link.yellow-btn svg path{
            transition: all 0.3s ease-in-out;
        }
        .section-{{ section.id }} .banner-link.yellow-btn:hover svg path{
            fill:#fff
        }
        .section-{{ section.id }} .banner-link.yellow-btn:hover{
            color: #fff;
        }
        .image-banner_text_wrapper .banner-image {
            display: flex;  
        }
        .bottom-text p {
            margin: 0;
            font-weight: 400;
            font-size: 16px;
            line-height: 13.42px;
            letter-spacing: 0px;
            text-align: center;
            padding: 10px 0;
            color: #000000;
            margin: 0px;
        }
        .image-banner_text_wrapper {
            position: relative;
        }
        .image-banner_text_wrapper .banner-content {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            bottom: 51px;
        }
        .image-banner_text_wrapper .banner-content.alignment-middle-center {
            align-items: center;
            justify-content: center;
        }
        .banner-content.alignment-bottom-center {
            align-items: center;
            justify-content: flex-end;
        }
        .banner-content.alignment-bottom-left {
            align-items: flex-start;
            justify-content: flex-end;
        }
        .banner-heading {
            font-weight: 500;
            font-size: 70px;
            line-height: 100%;
            letter-spacing: 0px;
            vertical-align: middle;
            margin: 0;
            margin-bottom: 50px;
        }
        p.banner-sub-heading {
            margin: 0;
            font-weight: 400;
            font-size: 20px;
            line-height: 140%;
            letter-spacing: 0px;
            vertical-align: middle;
        }
        .section-{{ section.id }} .content_iiner {
            max-width: {{ section.settings.banner_content_width }}px;
        }
        .for-mobile{
          display:none;
        }
        .image-banner_text_wrapper a.banner-link {
            font-weight: 400;
            font-size: 16px;
            line-height: 20.48px;
            letter-spacing: 0px;
            text-align: center;
            vertical-align: middle;
            text-transform: uppercase;
            color: #fff;
            background: #000;
            padding: 14px;
            display: flex;
            max-width: 220px;
            margin-top: 50px;
            text-decoration: none;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            z-index: 2;
             transition: all 0.3s ease-in-out;
        }
        .image-banner_text_wrapper a.banner-link svg path {
            fill: #fff;

        }
        .image-banner_text_wrapper a.banner-link::before {
            position: absolute;
            content: '';
            left: 0;
            top: 0;
            bottom: 0;
            background: #FFF544;
            z-index: -1;
            transition: all 0.3s ease-in-out;
            width:0
        }
        .image-banner_text_wrapper a.banner-link:hover{
            color:#000;
        }
        .image-banner_text_wrapper a.banner-link:hover::before {
            width: 100%;
        }
        .image-banner_text_wrapper a.banner-link:hover svg path{
          fill:#000;
        }
        @media (max-width:767px){
            .for-desktop{
                display: none;
            }
            .for-mobile{
                display:block;
            }
            .banner-header.page-width {
                display: none;
            }
            .image-banner_text_wrapper .banner-content{
                position: unset;
            }
           .section-{{ section.id }} .content_wraaper {
                background: #fff;
                padding: 50px 20px 12px;
            }  
            .for-mobile.banner_text_wrapper h2.heading {
                font-weight: 500;
                font-size: 30px;
                line-height: 100%;
                letter-spacing: 0px;
                text-align: center;
                vertical-align: middle;
                margin: 0;
            }
            .content_wraaper p {
                font-weight: 400;
                font-size: 16px;
                line-height: 130%;
                letter-spacing: 0px;
                text-align: center;
            }
            .for-mobile.banner_text_wrapper{
                position: relative;
            }
            .for-mobile.banner_text_wrapper a.banner-link {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                bottom: 39px;
                font-size: 16px;
                line-height: 20.48px;
                letter-spacing: 0px;
                text-align: center;
                vertical-align: middle;
                text-transform: uppercase;
                color: #fff;
                background: #000;
                padding: 14px;
                display: flex;
                max-width: 220px;
                text-decoration: none;
                align-items: center;
                justify-content: center;
                gap: 10px;
                z-index: 2;
                transition: all 0.3s ease-in-out;
            }
            .for-mobile.banner_text_wrapper a.banner-link svg path {
                fill: #fff;
            }       
        }
    </style>
    <div class="image-outer section-{{ section.id }}">
        {% for block in section.blocks %}
            {%  case block.type %}
                {% when 'banner-header' %}
                    <div class="banner-header page-width">
                        {%  if block.settings.image != blank %}
                           <div class="banner-image">
                                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="Banner Image" height="100%" width="100%">
                            </div>
                        {%  elsif block.settings.header_text != blank %}
                         <h2>{{ block.settings.header_text }}</h2>
                        {% endif %}
                        {% if block.settings.sub_header_text != blank %}
                            <p class="banner-sub-header">{{ block.settings.sub_header_text }}</p>
                        {% endif %}
                        {%  if block.settings.link_url or block.settings.link_text %}
                            <a href="{{ block.settings.link_url }}" class="banner-link yellow-btn">{{ block.settings.link_text }} {% render 'icons-arrow' %}</a>
                        {%  endif %}
                    </div>
                {% when 'banner-image' %}
                    <div class="image-banner_text_wrapper for-desktop">
                        <div class="banner-image">
                            <img src="{{ block.settings.banner_image | image_url: width: 800 }}" alt="Banner Image" height="100%" width="100%">
                        </div>
                        <div class="banner-content alignment-{{ block.settings.banner_content_alignment }} page-width">
                            <div class="content_iiner section-{{ section.id }}">
                               {%  if block.settings.banner_heading != blank %}
                                    <h2 class="banner-heading">{{ block.settings.banner_heading }}</h2>
                               {% endif %}
                               {% if block.settings.banner_sub_heading != blank %}
                                <p class="banner-sub-heading for-desktop">{{ block.settings.banner_sub_heading }}</p>
                                {% endif %}
                            {% if block.settings.banner-link != blank and block.settings.banner-link-text != blank %}
                                <a href="{{ block.settings.banner-link }}" class="banner-link">{{ block.settings.banner-link-text }} {% render 'icons-arrow' %}</a>
                            {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="for-mobile banner_text_wrapper">
                       <div class="content_wraaper">
                            <h2 class="heading">
                                {{ block.settings.mobile_heading }}
                            </h2>
                            <p>{{ block.settings.mobile_subheading }}</p>
                        </div>
                        {%  if block.settings.mobile_image != blank %}
                            <div class="image_wrapper">
                                <img src="{{ block.settings.mobile_image | image_url: width: 400 }}" height="" width="" alt="{{ block.settings.mobile_image.alt }}">
                               <a href="{{ block.settings.banner-link }}" class="banner-link">{{ block.settings.banner-link-text }} {% render 'icons-arrow' %}</a>
                            </div>
                        {% endif %}
                    </div>
                {% when 'bottom-text' %}
                    <div class="bottom-text for-desktop">
                        <p>{{ block.settings.bottom_text }}</p>
                    </div>
                     <div class="bottom-text for-mobile">
                        <p>{{ block.settings.bottom_text_mobile }}</p>
                    </div>
                {% endcase %}
            {% endfor %}
    </div>
{% schema  %}
{
    "name":"Custom Image Banner",
    "class": "image_banner_section_outer",
    "settings": [
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#F5F5F5"
        },
        {
            "type": "range",
            "id": "banner_content_width",
            "label": "Banner Content Width (px)",
            "min": 200,
            "max": 800,
            "step": 10,
            "default": 480,
            "unit": "px"
        }
    ],
    "blocks": [
        {
            "type": "banner-header",
            "name": "Banner Header",
            "settings": [
                {
                    "type": "text",
                    "id": "header_text",
                    "label": "Header Text"  
                },
                {
                "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "sub_header_text",
                    "label": "Sub Header Text"  
                },
                {
                    "type": "url",
                    "id": "link_url",
                    "label": "Link URL"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "Link Text"
                }
            ]  
        },
        {
            "type": "banner-image",
            "name": "Banner Image",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "banner_image",
                    "label": "Banner Image"
                },
                {
                    "type": "text",
                    "id": "banner_heading",
                    "label": "Banner Heading",
                    "default": "The Gift Guide"  
                },
                {
                    "type": "text",
                    "id": "banner_sub_heading",
                    "label": "Banner Sub Heading",
                    "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
                },
                {
                    "type": "url",
                    "id": "banner-link",
                    "label": "Banner Link"
                },
                {
                    "type": "text",
                    "id": "banner-link-text",
                    "label": "Banner Link Text"
                },
                {
                    "type": "select",
                    "id": "banner_content_alignment",
                    "label": "Banner Content Alignment",
                    "default": "bottom-left",
                    "options": [
                        {
                            "value": "middle-center",
                            "label": "Middle Center"
                        },
                        {
                            "value": "bottom-center",
                            "label": "Bottom Center"
                        },
                        {
                            "value": "bottom-left",
                            "label": "Bottom Left"
                        },
                        {
                            "value": "bottom-right",
                            "label": "Bottom Right"
                        }
                    ]
                },
                {
                    "type": "header",
                    "content": "Mobile Content"
                },
                {
                    "type": "text",
                    "id":"mobile_heading",
                    "label":"Mobile Heading"
                },
                {
                    "type": "text",
                    "id":"mobile_subheading",
                    "label":"Mobile Heading"
                },
                {
                    "type": "image_picker",
                    "id": "mobile_image",
                    "label": "Mobile Image"
                }
            ]
        },
        {
            "type": "bottom-text",
            "name": "Bottom Text",
            "settings": [
                {
                    "type": "text",
                    "id": "bottom_text",
                    "label": "Bottom Text"
                },
                {
                    "type": "header",
                    "content": "Mobile content"
                },
                {
                    "type": "text",
                    "id": "bottom_text_mobile",
                    "label": "Bottom Text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Custom Image Banner",
            "category": "Custom Sections"
        }
    ]
}
{% endschema %}